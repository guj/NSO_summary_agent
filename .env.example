# Configuration precedence for nso-diagnostic-run
# Existing process/shell environment overrides .env values (dotenv does not overwrite it).
# CLI overrides where supported:
#   DRY_RUN -> --publish (save/deliver) OR --dry-run (no normal state/delivery).
#              Supplying both flags is an error.
#   PROMETHEUS_PUSHGATEWAY_URL -> --skip-metrics disables pushing for this run.
#   --skip-llm disables LLM use even when FABRIC_AI_* is configured.
#   --deterministic-summary skips only the final LLM summary, not service digs.
#
# Command-line-only controls (not .env variable overrides):
#   --spine-concurrent-devices N, --dataplane-concurrent_works N (both default 1)
#   --max-dataplane-tools N (default 40), --max-dataplane-per-category N,
#   --max-dataplane-services N, --max-drill-issues N (default 2),
#   --max-tools-per-drill N (default 12), --max-deep-checks N, --max-handoffs N
#   --devices, --service-type, --service-id, --isis-only, --bgp-only,
#   --device-only, --service-only, --skip-service, --services-detail,
#   --save-mcp-results (can save raw results even during --dry-run).
#
# No diagnostic CLI flag changes NSO_SERVICE_SYNC_MODE, NSO connection/TLS settings,
# MCP_SERVER_CMD, STATE_DIR, LLM key/URL/model/temperature/timeouts/retries,
# IGNORE_SERVICE_TYPES, MAX_SERVICE_TYPES, or Slack/SMTP destinations/credentials.
# Override these for one invocation using shell environment assignments, e.g.:
#   NSO_SERVICE_SYNC_MODE=check FABRIC_CHAT_TIMEOUT_SEC=120 nso-diagnostic-run --dry-run
# Such assignments do not edit .env. Avoid putting secrets in shell history.
# Full list: nso-diagnostic-run --help

# NSO MCP server (stdio subprocess). Docker image defaults this; local installs:
# use an absolute path to your venv binary if it is not on PATH.
MCP_SERVER_CMD=cisco-nso-mcp-server
NSO_SCHEME=https
# Placeholder: set to your NSO hostname or IP.
NSO_ADDRESS=0.0.0.0
NSO_PORT=443
NSO_USERNAME=admin
NSO_PASSWORD=
# Verify NSO HTTPS certificate (default: 1). Set 0 only to deliberately bypass verification in a lab.
# NSO_VERIFY=1
# Optional CA bundle when using a private CA (implies verify):
# NSO_CA_BUNDLE=/path/to/ca-bundle.pem

# LLM (OpenAI-compatible chat API only)
# Env names are historical; defaults point at FABRIC AI (often free for FABRIC users).
# FABRIC_AI_API_URL must be an OpenAI-compatible base, NOT the full chat/completions URL.
# Use host root (https://ai.fabric-testbed.net) or …/v1; the client appends /v1 if missing.
# Do NOT use Anthropic-only bases (e.g. …/anthropic) — those fail with unsupported path.
FABRIC_AI_API_KEY=
FABRIC_AI_API_URL=https://ai.fabric-testbed.net
# Model choice affects diagnosis quality and run time; see "Running without an LLM and
# choosing a model" in docs/DIAGNOSTIC_RUNNER.md.
FABRIC_AI_MODEL=your-claude-opus5
# Default 0.1 when unset. Explicit blank omits the parameter (provider default).
# Set to 1 for models that require it (the Opus 5 endpoint we tested did); 0.1 suits others.
FABRIC_AI_TEMPERATURE=1
# Optional fallback when /key/info is unavailable (FABRIC-oriented; expires is often 1st of next month UTC)
# FABRIC_AI_KEY_EXPIRES=2026-07-01
# FABRIC_AI_KEY_CREATED=2026-06-25
# FABRIC_AI_KEY_LIFETIME_DAYS=30

# Agent
STATE_DIR=./state
# Default 1: stdout only; no normal diagnostic report state or delivery.
# Set 0 or pass --publish for persisted reports and configured Slack/email delivery.
DRY_RUN=1
# Rebuild static topology from NSO config on next run (default: only when devices/config change)
# TOPOLOGY_FORCE_UPDATE=1
# Admin-confirmed NSO↔box interface name mappings (optional JSON; see config/interface-equivalences.example.json)
# INTERFACE_EQUIVALENCES_FILE=config/interface-equivalences.json
# Comma-separated service types to omit from collection/reports (default: idipa)
IGNORE_SERVICE_TYPES=idipa
# Max distinct service types to fetch via get_services each run (default 10)
# MAX_SERVICE_TYPES=10
# How configuration sync is judged for each service: check (code default) or skip.
#   check  One NSO service check-sync call per service instance. When NSO gives no
#          verdict, the agent falls back to the sync state of the service's endpoint devices.
#   skip   No per-service calls. Uses only the endpoint devices' sync state, taken from
#          the single fleet-wide device check-sync that every run performs.
# skip is far cheaper (check adds one call per service) but coarser: it cannot see drift
# in one service while its devices are in sync, and one out-of-sync device marks every
# service on it as not in sync.
# This example uses skip because the NSO it was developed against returned no verdict
# (in_sync=null) from service check-sync for every service tested, so check cost a call
# per service and added nothing. To see how your NSO behaves, run a small scoped scan:
#   NSO_SERVICE_SYNC_MODE=check nso-diagnostic-run --service-only --service-type TYPE --skip-llm --dry-run
# If the report says "Service sync returned null for N/N instances", keep skip; if NSO
# returns real verdicts, use check.
# In both modes sync is a prerequisite, not proof of readiness, and the operational
# checks and LLM investigations still run.
NSO_SERVICE_SYNC_MODE=skip

# CPU/memory alert thresholds: config/fleet_summary_thresholds.yaml

# Optional delivery (enable one or both)
# Slack webhook: notification only, no HTML attachment.
# For HTML uploads use SLACK_BOT_TOKEN + SLACK_CHANNEL_ID below.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# Test: set -a && source .env && set +a && curl -sS -X POST -H 'Content-type: application/json' --data '{"text":"Slack webhook test"}' "$SLACK_WEBHOOK_URL"

# Email requires SMTP_HOST + EMAIL_FROM + EMAIL_TO.
# SMTP_USER/PASSWORD are needed only if your relay requires authentication.
# Leave EMAIL_TO unset to disable email.
# SMTP_HOST=smtp.example.com          # server hostname, not an email address
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=                          # SMTP login (Gmail: your Gmail address)
# SMTP_PASSWORD="abcd efgh ijkl mnop"   # Gmail App Password — quote if it contains spaces
# EMAIL_FROM=nso-summary@example.com  # From: header (Gmail: same as SMTP_USER)
# EMAIL_TO=ops@example.com,netops@example.com
# EMAIL_SUBJECT_PREFIX=NSO Summary

# Optional Prometheus metrics (Pushgateway). Unset = skip push.
# PROMETHEUS_PUSHGATEWAY_URL=http://127.0.0.1:9091
# PROMETHEUS_JOB=nso-summary
# PROMETHEUS_INSTANCE=laptop

# Optional diagnostic HTML upload to Slack. The bot needs the files:write scope and must be
# invited to the channel (/invite @your-app-name); otherwise the upload fails with not_in_channel.
# Set both; with only one of them the webhook is used instead.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional URL serving diagnostic runs/<run-id>/report.html. This does NOT host files.
DIAGNOSTIC_REPORT_BASE_URL=

# Additional attempts for SDK-retryable LLM errors, including timeouts.
# 0 = one attempt; 1 = up to two attempts. Nonnegative integer.
FABRIC_CHAT_MAX_RETRIES=0

# LLM per-attempt read timeout, seconds (positive finite number; default 60).
FABRIC_CHAT_TIMEOUT_SEC=60.0
# Connection establishment only; independent of response/read timeout.
FABRIC_CHAT_CONNECT_TIMEOUT_SEC=20.0
